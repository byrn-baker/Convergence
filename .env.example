# PostgreSQL Configuration
POSTGRES_DB=nautobot
POSTGRES_USER=nautobot
POSTGRES_PASSWORD=change_me_in_production

# Nautobot Configuration
NAUTOBOT_SECRET_KEY=change_me_to_50_random_characters_in_production
NAUTOBOT_API_TOKEN=0123456789abcdef0123456789abcdef01234567
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=admin

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AI Agent Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LANGCHAIN_API_KEY=your_langsmith_api_key_here_optional
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=convergence

# Network Device Credentials (for agent)
NETWORK_USERNAME=admin
NETWORK_PASSWORD=change_me
NETWORK_ENABLE_PASSWORD=change_me
