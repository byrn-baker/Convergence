# Convergence Platform Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Network Device Credentials
# ============================================================================

# Default credentials for network devices
NETWORK_USERNAME=admin
NETWORK_PASSWORD=your_network_password
NETWORK_ENABLE_PASSWORD=your_enable_password

# SNMP Configuration
SNMP_COMMUNITY=public

# Nautobot Configuration for Device Enrichment
# Get API token from Nautobot UI: Admin → Users → API Tokens
# API docs available at: https://YOUR_NAUTOBOT_IP/api/docs/
NAUTOBOT_URL=https://192.168.100.36
NAUTOBOT_TOKEN=your-api-token-here
NAUTOBOT_VERIFY_SSL=false  # Set to false for self-signed certs in development
SNMP_V3_USERNAME=snmpv3user
SNMP_V3_PASSWORD=snmpv3password
SNMP_V3_PRIV_PASSWORD=snmpv3privpassword

# ============================================================================
# Grafana Configuration
# ============================================================================

GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================================
# VictoriaMetrics Configuration
# ============================================================================

# Retention period for metrics (e.g., 30d, 90d, 1y)
VM_RETENTION_PERIOD=90d

# ============================================================================
# OpenTelemetry Collector Configuration
# ============================================================================

# Log level (debug, info, warn, error)
OTEL_LOG_LEVEL=info

# Batch processing
OTEL_BATCH_SIZE=1024
OTEL_BATCH_TIMEOUT=10s

# ============================================================================
# Platform Configuration
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Timezone
TZ=UTC

# ============================================================================
# Optional: API Keys for External Services
# ============================================================================

# PagerDuty integration key (for alerting)
# PAGERDUTY_INTEGRATION_KEY=your_key_here

# Slack webhook URL (for notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# Alerting Configuration (Phase 3)
# ============================================================================

# Webhook URL for Alertmanager/Grafana alert notifications
# Can be a Slack Incoming Webhook, custom HTTP endpoint, or automation trigger
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook URL — used by the Grafana Discord contact point
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Email address for critical alert notifications
# ALERT_EMAIL=admin@example.com

# Alertmanager external URL (used in alert annotations)
ALERTMANAGER_URL=http://localhost:9093

# Grafana alert evaluation interval
GRAFANA_ALERT_EVAL_INTERVAL=1m

# ============================================================================
# Phase 4: Threat Intelligence API Keys
# ============================================================================

# AbuseIPDB — https://www.abuseipdb.com/register (free tier: 1000 checks/day)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# GreyNoise — https://www.greynoise.io (community API works without key)
GREYNOISE_API_KEY=your_greynoise_api_key_here

# AlienVault OTX — https://otx.alienvault.com/accounts/signup
OTX_API_KEY=your_otx_api_key_here

# IPInfo — https://ipinfo.io/signup (free tier: 50k lookups/month)
IPINFO_TOKEN=your_ipinfo_token_here

# Anthropic (Claude Haiku for AI narratives) — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# Phase 5: Automation Agent
# ============================================================================

# pfSense connection — XML-RPC (primary integration path)
# Set pfsense_host to your pfSense LAN/management IP (e.g. 192.168.1.1)
# PFSENSE_HOST=192.168.1.1
# PFSENSE_XMLRPC_USER=admin
# PFSENSE_XMLRPC_PASS=your_pfsense_web_password

# pfSense connection — SSH (fallback; add to runtime pf table immediately)
# Generate a dedicated key: ssh-keygen -t ed25519 -f pfsense_id_ed25519 -C "convergence-autoagent"
# Add the public key to pfSense: System > User Manager > admin > Authorized SSH Keys
# Then mount the private key into the container via a docker secret or bind mount
# PFSENSE_SSH_HOST=192.168.1.1
# PFSENSE_SSH_USER=admin
# PFSENSE_SSH_KEY_PATH=/app/secrets/pfsense_id_ed25519

# Safety controls (defaults are intentionally conservative)
# Master kill-switch: true = log & Discord-notify only, never touch pfSense
DRY_RUN=true
# composite_score must be >= this to even consider a block action
AUTO_ACTION_THRESHOLD=80
# composite_score must be >= this to skip Discord approval and auto-execute
# Set to 101 to always require human approval for every action
AUTO_APPROVE_THRESHOLD=95
# Hard cap: never execute more than N live actions per rolling 60-minute window
MAX_ACTIONS_PER_HOUR=5
# Temporary block duration (hours) — pfBlockerNG list TTL
BLOCK_TTL_HOURS=24
# How often the agent polls threat-intel for new high-risk IPs (seconds)
POLL_INTERVAL_SECONDS=600

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable hot reload for configs
HOT_RELOAD=true

# Mock telemetry generator
GENERATE_MOCK_DATA=false
