  "description": "pfSense Firewall Security — OPNsense-style layout with Hardware, Firewall, and Network Stats collapsible rows.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🖥️ Hardware",
      "type": "row",
      "panels": [

        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
              "unit": "d",
              "decimals": 1
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
          "id": 1,
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "justifyMode": "center",
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "textMode": "auto"
          },
          "title": "System Uptime",
          "type": "stat",
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
              "expr": "system_uptime_seconds{device_name=\"pfSense-FW01\"} / 86400",
              "legendFormat": "Uptime",
              "refId": "A"
            }
          ]
        },

        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "mappings": [],
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "#EAB839", "value": 70 },
                  { "color": "red", "value": 90 }
                ]
              },
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
          "id": 2,
          "options": {
            "minVizHeight": 75,
            "minVizWidth": 75,
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "showThresholdLabels": false,
            "showThresholdMarkers": true
          },
          "title": "CPU Usage",
          "type": "gauge",
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
              "expr": "avg(system_cpu_load_ratio{device_name=\"pfSense-FW01\"})",
              "legendFormat": "CPU %",
              "refId": "A"
            }
          ]
        },

        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
              "mappings": [],
              "max": 100,
              "min": 0,
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 16, "x": 8, "y": 1 },
          "id": 3,
          "options": {
            "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
            "tooltip": { "mode": "multi", "sort": "none" }
          },
          "title": "CPU Over Time",
          "type": "timeseries",
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
              "expr": "system_cpu_load_ratio{device_name=\"pfSense-FW01\"}",
              "legendFormat": "{{ cpu_description }}",
              "refId": "A"
            }
          ]
        },

        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
              "mappings": [],
              "min": 0,
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 8, "x": 0, "y": 5 },
          "id": 4,
          "options": {
            "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
            "tooltip": { "mode": "multi", "sort": "none" }
          },
          "title": "CPU Load (all cores)",
          "description": "Per-core CPU load % from HOST-RESOURCES-MIB hrProcessorLoad.\n\nNote: Load average (1/5/15 min) is not available via pfSense bsnmpd — it requires the UCD-SNMP-MIB ucd.so module. To enable: pfSense > Services > SNMP > Modules > check 'ucd'.\nRequires hostres.so module to be enabled in pfSense SNMP service.",
          "type": "timeseries",
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
              "expr": "system_cpu_load_ratio{device_name=\"pfSense-FW01\"}",
              "legendFormat": "{{ cpu_description }}",
              "refId": "A"
            }
          ]
        },

        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
              "mappings": [],
              "max": 100,
              "min": 0,
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 8, "x": 8, "y": 5 },
          "id": 5,
          "options": {
            "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
            "tooltip": { "mode": "multi", "sort": "none" }
          },
          "title": "RAM Usage",
          "description": "RAM used % from HOST-RESOURCES-MIB hrStorage 'Real Memory Metrics' entry.",
          "type": "timeseries",
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
              "expr": "system_storage_used{device_name=\"pfSense-FW01\", storage_description=\"Real Memory Metrics\"} / system_storage_size{device_name=\"pfSense-FW01\", storage_description=\"Real Memory Metrics\"} * 100",
              "legendFormat": "RAM Used %",
              "refId": "A"
            }
          ]
        },

        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
              "mappings": [],
              "max": 100,
              "min": 0,
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 8, "x": 16, "y": 5 },
          "id": 6,
          "options": {
            "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
            "tooltip": { "mode": "multi", "sort": "none" }
          },
          "title": "Disk Utilization",
          "description": "Percentage used per storage partition (hrStorage table). Partitions with zero blocks are filtered out.",
          "type": "timeseries",
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
              "expr": "system_storage_used{device_name=\"pfSense-FW01\", storage_description!~\"UMA:.*\"} / system_storage_size{device_name=\"pfSense-FW01\", storage_description!~\"UMA:.*\"} * 100 > 0",
              "legendFormat": "{{ storage_description }}",
              "refId": "A"
            }
          ]
        }

      ]
    },

