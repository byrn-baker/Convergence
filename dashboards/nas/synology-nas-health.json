    {
      "id": 5,
      "title": "NAS01 Uptime",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
