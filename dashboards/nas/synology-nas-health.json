{
  "title": "Synology NAS Health",
  "uid": "convergence-nas-health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "nas",
    "synology",
    "convergence"
  ],
  "panels": [
    {
      "id": 1,
      "title": "NAS01 System Temperature",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 45
              },
              {
                "color": "red",
                "value": 55
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "nas_system_temperature_celsius{device_name=\"SynologyNAS01\"}",
          "legendFormat": "NAS01 Temp"
        }
      ]
    },
    {
      "id": 2,
