    {
      "id": 20,
      "title": "RAID Volume Usage \u2014 NAS01",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "max": 1,
          "min": 0,
          "decimals": 1
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "lcd"
      },
      "targets": [
        {
          "expr": "1 - (nas_raid_free_bytes{device_name=\"SynologyNAS01\",raid_name=~\"Volume.*\"} / nas_raid_total_bytes{device_name=\"SynologyNAS01\",raid_name=~\"Volume.*\"})",
          "legendFormat": "{{raid_name}} used %"
        }
      ]
    },
    {
      "id": 21,
      "title": "RAID Volume Usage \u2014 NAS02",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
