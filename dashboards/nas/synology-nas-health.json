                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "system_uptime_seconds{device_name=\"SynologyNAS01\"} / 100",
          "legendFormat": "NAS01 Uptime"
        }
