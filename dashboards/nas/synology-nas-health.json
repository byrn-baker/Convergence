    {
      "id": 10,
      "title": "Disk Status \u2014 NAS01",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Normal",
                  "color": "green"
                },
                "2": {
                  "text": "Initialized",
                  "color": "blue"
                },
                "3": {
                  "text": "Not Init",
                  "color": "yellow"
                },
                "4": {
                  "text": "Partition Fail",
                  "color": "orange"
                },
                "5": {
                  "text": "CRASHED",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "sortBy": [
          {
            "displayName": "disk_id"
          }
        ]
      },
      "targets": [
        {
          "expr": "nas_disk_status_ratio{device_name=\"SynologyNAS01\"}",
          "legendFormat": "{{disk_id}} Status",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "nas_disk_temperature_celsius{device_name=\"SynologyNAS01\"}",
          "legendFormat": "{{disk_id}} Temp",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "disk_id": "Disk",
              "Value #A": "Status",
              "Value #B": "Temp (\u00b0C)"
            }
          }
        }
      ]
    },
