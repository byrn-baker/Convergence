    },
    {
      "id": 30,
      "title": "RAID Status",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 5
      },
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Normal",
                  "color": "green"
                },
                "2": {
                  "text": "Repairing",
                  "color": "blue"
                },
                "3": {
                  "text": "Migrating",
                  "color": "blue"
                },
                "4": {
                  "text": "Expanding",
                  "color": "blue"
                },
                "7": {
                  "text": "Syncing",
                  "color": "yellow"
                },
                "8": {
                  "text": "Parity Check",
                  "color": "yellow"
                },
                "11": {
                  "text": "DEGRADED",
                  "color": "orange"
                },
                "12": {
                  "text": "CRASHED",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "nas_raid_status_ratio",
          "legendFormat": "{{device_name}} / {{raid_name}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "device_name": "Device",
              "raid_name": "Volume",
              "Value": "Status"
            }
          }
        }
      ]
    },
    {
      "id": 40,
      "title": "Network Throughput \u2014 NAS01",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 6
      },
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "rate(interface_in_octets_bytes_total{device_name=\"SynologyNAS01\"}[2m])",
          "legendFormat": "{{interface_name}} in"
        },
        {
          "expr": "rate(interface_out_octets_bytes_total{device_name=\"SynologyNAS01\"}[2m])",
          "legendFormat": "{{interface_name}} out"
        }
      ]
